## Ignore Visual Studio temporary files, build results, and
## files generated by popular editors.
# Compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so

# Folder view files
.DS_Store
Desktop.ini

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Release]/
[Releases]/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Log]/
[Logs]/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you have tasks that create toplevel directories there
#TopLevel/

# Rider/Resharper
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# Local Db and SQL Express files
*.mdf
*.ldf
*.ndf

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/
# template engine cache
.templateengine/

# Docker
.dockerignore

# User settings
appsettings.local.json
